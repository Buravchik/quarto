{
  "name": "quarto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "test:miniapp": "vitest run tests/unit/miniapp",
    "smoke:miniapp": "node scripts/smoke-miniapp.mjs",
    "smoke:api": "node scripts/smoke-prod.mjs",
    "bot:start": "tsx src/telegram/bot.ts",
    "bot:docker": "docker build -t quarto-bot . && docker run --env-file .env -p 8080:8080 quarto-bot",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "telegraf": "^4.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.1.1"
  }
}
