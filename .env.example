BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://example.pages.dev
# Mini App build-time API origin (bot host). Example: https://quarto-bot.example.com
NEXT_PUBLIC_API_BASE=
# Extra browser origins for CORS (comma-separated). TELEGRAM_WEBAPP_URL is always allowed.
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PORT=8080
# local: omit WEBHOOK_URL → long polling
# prod: set WEBHOOK_URL=https://your-bot-host/telegram
WEBHOOK_URL=
