BOT_TOKEN=
# Optional; otherwise taken from getMe() at bot startup
BOT_USERNAME=
# Mini App short name from BotFather (for t.me/<bot>/<short>?startapp= deep links)
TELEGRAM_MINI_APP_SHORT_NAME=
# Mini App origin (GitHub Pages). Prod example: https://buravchik.github.io/quarto
TELEGRAM_WEBAPP_URL=https://example.github.io/quarto
# Mini App build-time API origin = Cloud Run service URL (not a tunnel).
# Prod example: https://quarto-bot-xxxx-ew.a.run.app
NEXT_PUBLIC_API_BASE=
# Extra browser origins for CORS (comma-separated). TELEGRAM_WEBAPP_URL is always allowed.
# Prod example: https://buravchik.github.io
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PORT=8080
# local: omit WEBHOOK_URL → long polling (do not run against the same bot token as prod webhook)
# prod (Cloud Run): WEBHOOK_URL=https://<cloud-run-url>/telegram
WEBHOOK_URL=
